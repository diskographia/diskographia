DATABASE_URL=postgresql://ЛОГИН:ПАРОЛЬ@localhost:5432/diskographia

# сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_TTL=7d

PORT=4000
NODE_ENV=development

UPLOADS_DIR=./uploads
CLIENT_ORIGINS=http://localhost:3000

DATABASE_POOL_SIZE=10
UPLOAD_MAX_BYTES=209715200
PREVIEW_WIDTH=640
PREVIEW_QUALITY=82
PLATFORM_HANDLE=discography

# учётка платформы, её заводит и обновляет pnpm --filter server seed:admin
PLATFORM_EMAIL=admin@diskographia.test
PLATFORM_PASSWORD=

HOME_SELECTION_SLUG=home-selection
HOME_SHOWCASE_SLUG=home-showcase

# капсула-манифест платформы, открывается по летающим логотипам
PLATFORM_MANIFEST_SLUG=manifest
SEARCH_PAGE_SIZE=24
SEARCH_PAGE_SIZE_MAX=100
SEARCH_TAG_FACETS=40
SIMILAR_LIMIT=12
PARTICIPANT_ROLE_NAME=участник

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# набор открывается вручную, когда придёт время пускать людей
REGISTRATION_OPEN=false
