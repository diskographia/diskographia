# адреса читает браузер, они вшиваются в сборку
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_UPLOADS_URL=http://localhost:4000/uploads
NEXT_PUBLIC_PLATFORM_HANDLE=discography
NEXT_PUBLIC_HOME_SELECTION_SLUG=home-selection
NEXT_PUBLIC_HOME_SHOWCASE_SLUG=home-showcase
NEXT_PUBLIC_PLATFORM_MANIFEST_SLUG=manifest

# демо: служебные адреса только учётке платформы
NEXT_PUBLIC_DEMO_MODE=true

# серверные запросы клиента к api, если сервер ближе, чем публичный адрес. в разработке не нужен
# API_INTERNAL_URL=http://localhost:4000/api
