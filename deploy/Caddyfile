# caddy стоит на самой машине, а не в контейнере, и держит сертификаты сам.
# на сервере это часть общего /etc/caddy/Caddyfile хоста: здесь только наши блоки, править их через sudoedit,
# проверка: caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile, применить: sudo systemctl reload caddy.
# порты 3500 и 4500 это CLIENT_PORT и SERVER_PORT из .env.production

https://disk64.zip {
	encode zstd gzip

	# файл до двухсот мегабайт, тот же предел стоит на сервере в UPLOAD_MAX_BYTES
	request_body {
		max_size 210MB
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# api уходит сразу серверу: кука с токеном читается им самим
	handle /api/* {
		reverse_proxy 127.0.0.1:4500 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy 127.0.0.1:3500
	}
}

# главное имя одно: disk64.zip, старое и www на него перекидывают
https://www.disk64.zip, https://diskographia.zip {
	redir https://disk64.zip{uri} permanent
}

# пользовательские файлы живут на отдельном имени, чтобы чужой скрипт не оказался на нашем
files.disk64.zip {
	root * /srv/diskographia/uploads
	file_server

	header {
		X-Content-Type-Options nosniff
		Content-Security-Policy "default-src 'none'; sandbox"
		Cross-Origin-Resource-Policy cross-origin
		Cache-Control "public, max-age=2592000, immutable"
		-Server
	}

	# всё, кроме картинок и медиа, скачивается, а не показывается: то же правило, что на сервере
	@download {
		not path *.jpg *.jpeg *.png *.webp *.avif *.gif *.mp3 *.flac *.wav *.ogg *.mp4 *.webm *.mov
	}
	header @download Content-Disposition attachment
}
