# один файл на весь стенд, рядом с docker-compose.yml, в гит не попадает

POSTGRES_DB=diskographia
POSTGRES_USER=diskographia
POSTGRES_PASSWORD=

DATABASE_URL=postgresql://diskographia:ПАРОЛЬ@postgres:5432/diskographia
DATABASE_POOL_SIZE=10

# сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_TTL=7d

PORT=4000
NODE_ENV=production
CLIENT_ORIGINS=https://diskographia.ru

# порты слушаются только на 127.0.0.1, наружу их выводит caddy на самой машине
SERVER_PORT=4000
CLIENT_PORT=3000

# папка с загруженными файлами на диске сервера, её же раздаёт caddy
UPLOADS_HOST_DIR=/srv/diskographia/uploads

UPLOAD_MAX_BYTES=209715200
PREVIEW_WIDTH=640
PREVIEW_QUALITY=82

PLATFORM_HANDLE=discography
PLATFORM_EMAIL=admin@diskographia.ru
PLATFORM_PASSWORD=

HOME_SELECTION_SLUG=home-selection
HOME_SHOWCASE_SLUG=home-showcase
PLATFORM_MANIFEST_SLUG=manifest

SEARCH_PAGE_SIZE=24
SEARCH_PAGE_SIZE_MAX=100
SEARCH_TAG_FACETS=40
SIMILAR_LIMIT=12
PARTICIPANT_ROLE_NAME=участник

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# эти читает клиент, они вшиваются в сборку
NEXT_PUBLIC_API_URL=https://diskographia.ru/api
NEXT_PUBLIC_UPLOADS_URL=https://files.diskographia.ru
NEXT_PUBLIC_PLATFORM_HANDLE=discography
NEXT_PUBLIC_HOME_SELECTION_SLUG=home-selection
NEXT_PUBLIC_HOME_SHOWCASE_SLUG=home-showcase
NEXT_PUBLIC_PLATFORM_MANIFEST_SLUG=manifest

# набор закрыт, открывается вручную
REGISTRATION_OPEN=false

# демо: служебные адреса только учётке платформы. значение вшивается в сборку клиента
NEXT_PUBLIC_DEMO_MODE=true
